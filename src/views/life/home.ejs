<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LifeScorecard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", sans-serif;
    }

    body {
      background: #0b0b0b;
      color: #ffffff;
    }

    /* HERO */
    .hero {
      height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: radial-gradient(circle at top, #1a1a1a, #000);
    }

    .hero h1 {
      font-size: 4rem;
      letter-spacing: 4px;
    }

    .role {
      color: #aaa;
      margin-top: 10px;
      font-size: 1.1rem;
    }

    /* SNAPSHOT */
    .snapshot {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      padding: 60px 10%;
    }

    .card {
      background: #121212;
      border: 1px solid #1f1f1f;
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: #00ffcc;
      box-shadow: 0 0 15px rgba(0, 255, 204, 0.15);
    }

    .card h3 {
      color: #aaa;
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .card p {
      font-size: 2.4rem;
      margin-top: 10px;
    }

    /* GITHUB STATS */
    .quick-stats {
      display: flex;
      justify-content: space-around;
      padding: 40px 10%;
      background: #0f0f0f;
      flex-wrap: wrap;
      gap: 20px;
    }

    .stat {
      color: #aaa;
      text-align: center;
    }

    .stat span {
      display: block;
      color: #00ffcc;
      font-size: 1.6rem;
      margin-top: 5px;
    }

    /* FORM GUIDE */
    .form-guide {
      padding: 60px 10%;
      text-align: center;
    }

    .form-box {
      display: flex;
      justify-content: center;
      gap: 15px;
    }

    .form-box span {
      font-size: 1.6rem;
      padding: 12px 16px;
      border-radius: 8px;
    }

    .win {
      background: rgba(0, 255, 204, 0.15);
      color: #00ffcc;
      border: 1px solid #00ffcc;
    }

    .loss {
      background: rgba(255, 0, 0, 0.15);
      color: #ff4d4d;
      border: 1px solid #ff4d4d;
    }
  </style>
</head>
<body>

<!-- HERO -->
<section class="hero">
  <div>
    <h1><%= life.name %></h1>
    <p class="role"><%= life.role %></p>

    <% if (life.github && life.github.avatar) { %>
      <img src="<%= life.github.avatar %>" width="90" style="border-radius:50%; margin-top:20px;">
    <% } %>
  </div>
</section>

<!-- SNAPSHOT -->
<section class="snapshot">
  <div class="card">
    <h3>YEARS ACTIVE</h3>
    <p><%= yearsActive %></p>
  </div>

  <div class="card">
    <h3>TOTAL PROJECTS</h3>
    <p><%= life.stats.totalProjects %></p>
  </div>

  <div class="card">
    <h3>DOMAINS</h3>
    <p><%= life.stats.domains %></p>
  </div>

  <div class="card">
    <h3>SKILLS RATED</h3>
    <p><%= life.stats.skillsRated %></p>
  </div>
</section>

<!-- GITHUB STATS -->
<section class="quick-stats">
  <div class="stat">
    GitHub Repos
    <span><%= life.github.repos %></span>
  </div>

  <div class="stat">
    Followers
    <span><%= life.github.followers %></span>
  </div>

  <div class="stat">
    Following
    <span><%= life.github.following %></span>
  </div>

  <div class="stat">
    GitHub Since
    <span><%= new Date(life.github.githubSince).getFullYear() %></span>
  </div>
</section>

<!-- FORM GUIDE -->
<section class="form-guide">
  <h2>RECENT FORM</h2>

  <div class="form-box">
    <% if (life.form && life.form.length > 0) { %>
      <% life.form.forEach(f => { %>
        <span class="<%= f === 'W' ? 'win' : 'loss' %>">
          <%= f === 'W' ? '✔' : '❌' %>
        </span>
      <% }) %>
    <% } else { %>
      <p style="color:#777;">No activity data yet</p>
    <% } %>
  </div>
</section>

</body>
</html>
